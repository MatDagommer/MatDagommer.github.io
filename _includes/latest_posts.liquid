<div class="latest-posts">
  {% if site.latest_posts != blank %}
    {% assign latest_posts = site.posts %}
    {% if site.latest_posts.limit %}
      {% assign latest_posts_limit = site.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = site.posts | size %}
    {% endif %}
    
    {% for item in latest_posts limit: latest_posts_limit %}
      <div class="post-box" style="border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 1rem; margin-bottom: 0.75rem; background-color: #fff;">
        <div class="post-content">
          <span style="color: #6c757d; font-size: 0.9rem;">{{ item.date | date: "%Y-%m-%d" }}</span>
          <span style="margin: 0 0.5rem;">-</span>
          {% if item.redirect == blank %}
            <a href="{{ item.url | relative_url }}" style="color: #000; text-decoration: none; font-weight: 500;">{{ item.title }}</a>
          {% elsif item.redirect contains '://' %}
            <a href="{{ item.redirect }}" target="_blank" style="color: #000; text-decoration: none; font-weight: 500;">{{ item.title }}</a>
          {% else %}
            <a href="{{ item.redirect | relative_url }}" style="color: #000; text-decoration: none; font-weight: 500;">{{ item.title }}</a>
          {% endif %}
          {% if item.tags %}
            <span style="margin: 0 0.5rem;">-</span>
            <span style="color: #6c757d; font-size: 0.9rem;">Tags: </span>
            {% for tag in item.tags %}
              <span style="color: #007bff; font-size: 0.9rem;">#{{ tag | strip }}</span>{% unless forloop.last %}, {% endunless %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
